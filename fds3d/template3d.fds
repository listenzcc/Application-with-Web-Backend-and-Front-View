&HEAD CHID='plant', TITLE='大型冶金厂区CO泄漏扩散：下游塔、管道、厂房绕流'/
&TIME T_END=20.0/

&DUMP RENDER_FILE='plant.ge1',
      DT_BNDF=5.0,
      DT_DEVC=1.0,
      DT_PL3D=5.0,
      DT_RESTART=60.0,
      DT_SLCF=2.0,
      NFRAMES=600,
      WRITE_XYZ=.TRUE.,
      PLOT3D_QUANTITY(1)='VOLUME FRACTION',
      PLOT3D_SPEC_ID(1)='CO',
      PLOT3D_QUANTITY(2)='MASS FRACTION',
      PLOT3D_SPEC_ID(2)='CO'/

! 扩大后的厂区：200m × 150m × 40m，网格 1m
&MESH ID='Mesh01', IJK=200,150,40, XB=0.0,200.0,0.0,150.0,0.0,40.0/

&SPEC ID='CO', MW=28.0/

! ========= 测点：沿下游中心线布置，显示扩散路径 =========
&DEVC ID='CO_X50',  QUANTITY='VOLUME FRACTION', SPEC_ID='CO', XYZ=50,75,5.0/
&DEVC ID='CO_X70',  QUANTITY='VOLUME FRACTION', SPEC_ID='CO', XYZ=70,75,5.0/
&DEVC ID='CO_X90',  QUANTITY='VOLUME FRACTION', SPEC_ID='CO', XYZ=90,75,5.0/
&DEVC ID='CO_X110', QUANTITY='VOLUME FRACTION', SPEC_ID='CO', XYZ=110,75,5.0/
&DEVC ID='CO_X130', QUANTITY='VOLUME FRACTION', SPEC_ID='CO', XYZ=130,75,5.0/
&DEVC ID='CO_X150', QUANTITY='VOLUME FRACTION', SPEC_ID='CO', XYZ=150,75,5.0/
&DEVC ID='CO_X170', QUANTITY='VOLUME FRACTION', SPEC_ID='CO', XYZ=170,75,5.0/

! 近泄漏点
&DEVC ID='CO_NEAR_LEAK', QUANTITY='VOLUME FRACTION', SPEC_ID='CO', XYZ=40,75,6.5/
&DEVC ID='VEL_NEAR_LEAK', QUANTITY='VELOCITY', XYZ=40,75,6.5/

! ========= 材料与表面 =========
&MATL ID='STEEL',
      SPECIFIC_HEAT=0.45,
      CONDUCTIVITY=50.0,
      DENSITY=7850.0/
&MATL ID='CONCRETE',
      SPECIFIC_HEAT=0.88,
      CONDUCTIVITY=1.5,
      DENSITY=2400.0/

&SURF ID='CONVERTER_SURF',
      MATL_ID(1,1)='STEEL',
      MATL_MASS_FRACTION(1,1)=1.0,
      THICKNESS(1)=0.1/

&SURF ID='WALL_SURF',
      COLOR='GRAY',
      MATL_ID(1,1)='CONCRETE',
      MATL_MASS_FRACTION(1,1)=1.0,
      THICKNESS(1)=0.1/

! 入口风：X=0 面，VEL=-1.0 表示沿 +X 吹入
&SURF ID='Supply',
      RGB=26,204,26,
      VEL=-1.0/

! CO 泄漏面：质量通量 kg/(m²·s)
&SURF ID='LEAK_SURF',
      COLOR='RED',
      MASS_FLUX=0.1,
      SPEC_ID='CO',
      TAU_MF=1.0/

! ========= 泄漏源上游：煤气管道 =========
&OBST ID='Pipe_Upstream', XB=30,50,74,76,5,6, SURF_ID='CONVERTER_SURF'/

! 泄漏口在管道顶面 Z=6，面积 2m×2m
&VENT ID='Vent_Leak', SURF_ID='LEAK_SURF', XB=39,41,74,76,6,6/

! ========= 下游障碍物：显示扩散路径 =========

! 厂房1：泄漏源下游左侧
&OBST ID='Building_1', XB=60,80,50,70,0,12, SURF_ID='WALL_SURF'/

! 厂房2：下游右侧
&OBST ID='Building_2', XB=90,110,90,110,0,10, SURF_ID='WALL_SURF'/

! 脱硫塔：中心 (120,75)，半径约 5m，高 25m，用 8 个 OBST 近似
&OBST ID='Desulf01', XB=115,125,72.5,77.5,0,25, SURF_ID='CONVERTER_SURF'/
&OBST ID='Desulf02', XB=116.5,123.5,69.5,80.5,0,25, SURF_ID='CONVERTER_SURF'/
&OBST ID='Desulf03', XB=118.5,121.5,68.0,82.0,0,25, SURF_ID='CONVERTER_SURF'/
&OBST ID='Desulf04', XB=119.5,120.5,67.5,82.5,0,25, SURF_ID='CONVERTER_SURF'/
&OBST ID='Desulf05', XB=119.5,120.5,67.5,82.5,0,25, SURF_ID='CONVERTER_SURF'/
&OBST ID='Desulf06', XB=118.5,121.5,68.0,82.0,0,25, SURF_ID='CONVERTER_SURF'/
&OBST ID='Desulf07', XB=116.5,123.5,69.5,80.5,0,25, SURF_ID='CONVERTER_SURF'/
&OBST ID='Desulf08', XB=115,125,72.5,77.5,0,25, SURF_ID='CONVERTER_SURF'/

! 熄焦塔：中心 (150,45)，半径约 4m，高 30m
&OBST ID='Coke01', XB=146,154,43,47,0,30, SURF_ID='CONVERTER_SURF'/
&OBST ID='Coke02', XB=147,153,41,49,0,30, SURF_ID='CONVERTER_SURF'/
&OBST ID='Coke03', XB=148.5,151.5,40,50,0,30, SURF_ID='CONVERTER_SURF'/
&OBST ID='Coke04', XB=149.5,150.5,39.5,50.5,0,30, SURF_ID='CONVERTER_SURF'/
&OBST ID='Coke05', XB=149.5,150.5,39.5,50.5,0,30, SURF_ID='CONVERTER_SURF'/
&OBST ID='Coke06', XB=148.5,151.5,40,50,0,30, SURF_ID='CONVERTER_SURF'/
&OBST ID='Coke07', XB=147,153,41,49,0,30, SURF_ID='CONVERTER_SURF'/
&OBST ID='Coke08', XB=146,154,43,47,0,30, SURF_ID='CONVERTER_SURF'/

! 架空管道：沿 Y 方向横穿下游，制造绕流
&OBST ID='Pipe_Down1', XB=95,97,30,120,8,9, SURF_ID='CONVERTER_SURF'/
&OBST ID='Pipe_Down2', XB=130,132,40,130,10,11, SURF_ID='CONVERTER_SURF'/

! 烟囱：细高，位于下游远端
&OBST ID='Chimney', XB=170,172,70,72,0,45, SURF_ID='CONVERTER_SURF'/

! ========= 计算域边界 =========
&VENT ID='Vent_WindIn', SURF_ID='Supply', XB=0.0,0.0,0.0,150.0,0.0,40.0/
&VENT ID='Vent_Out',    SURF_ID='OPEN',   XB=200.0,200.0,0.0,150.0,0.0,40.0/
&VENT ID='Vent_Y0',     SURF_ID='OPEN',   XB=0.0,200.0,0.0,0.0,0.0,40.0/
&VENT ID='Vent_Y150',   SURF_ID='OPEN',   XB=0.0,200.0,150.0,150.0,0.0,40.0/
&VENT ID='Vent_Ground', SURF_ID='WALL_SURF', XB=0.0,200.0,0.0,150.0,0.0,0.0/
&VENT ID='Vent_Top',    SURF_ID='OPEN',   XB=0.0,200.0,0.0,150.0,40.0,40.0/

! ========= 切片：显示扩散路径 =========
! 中心垂直切片
&SLCF QUANTITY='VOLUME FRACTION', SPEC_ID='CO', PBY=75/
&SLCF QUANTITY='VELOCITY', VECTOR=.TRUE., PBY=75/

! 泄漏高度水平切片
&SLCF QUANTITY='VOLUME FRACTION', SPEC_ID='CO', PBZ=6.0/
&SLCF QUANTITY='VELOCITY', VECTOR=.TRUE., PBZ=6.0/

! 沿下游几个横截面
&SLCF QUANTITY='VOLUME FRACTION', SPEC_ID='CO', PBX=70/
&SLCF QUANTITY='VOLUME FRACTION', SPEC_ID='CO', PBX=110/
&SLCF QUANTITY='VOLUME FRACTION', SPEC_ID='CO', PBX=150/
&SLCF QUANTITY='VELOCITY', VECTOR=.TRUE., PBX=110/

! ========= CO 等值面：直接显示羽流包络 =========
&ISOF QUANTITY='VOLUME FRACTION', SPEC_ID='CO', VALUE=0.0001/
&ISOF QUANTITY='VOLUME FRACTION', SPEC_ID='CO', VALUE=0.001/

&TAIL /